<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Add Book</title>
        <style>
            body{
                font-family: Arial, Helvetica, sans-serif;
            }
            
            .primary{
                background-color: cadetblue;
                color: white;
            }
            .btn {
                padding: 5px 10px;
                display: inline-block;
                margin: 2px;
                text-decoration: none;
                border-radius: 5px;
            }

            .show{
                display: none;
            }

            .show-top:hover +.show{
                display: block;
            }
        </style>
    </head>
    <body>
        <header>
            <section>
                <h1 style="text-align: center;">Add Book</h1>
            </section>
            <section>
                <a href="/" class="btn primary">Home Page</a>
                <a href="/viewbooks" class="btn primary">View Books</a>
            </section>
        </header>

        <main>
            <section style="padding: 40px;">
                <form action="/addbook" method="post" enctype="multipart/form-data">
                    <div>
                        <label for="name">Book Name:</label>
                        <input type="text" id="name" name="bookname" placeholder="Enter book name" required>
                    </div>
                    <br>
                    <div>
                        <label for="author">Author:</label>
                        <input type="text" id="author" name="author" placeholder="Enter Author name" required>
                    </div>
                    <br>
                    <div>
                        <label for="category">Category:</label>
                        <input type="text" id="category" name="category" placeholder="Enter Category" required>
                    </div>
                    <br>
                    <div>
                        <label for="price">Price (in Rs.):</label>
                        <input type="number" id="price" name="price" placeholder="Enter your name" required>
                    </div>
                    <br>
                    <div>
                        <label for="quantity">Quantity:</label>
                        <input type="number" id="quantity" name="quantity" placeholder="Enter your name" required>
                    </div>
                    <br>
                    <div style="display: flex; align-items: start;">
                        <label for="description">Description:</label>
                        <textarea type="text" id="description" name="description" placeholder="Enter your name" required></textarea>
                    </div>
                    <br>
                    <div>
                        <label for="image">Cover Image:</label>
                        <input type="file" name="image">
                    </div>
                    <br>
                    <button>Submit and add book</button>
                </form>
            </section>
        </main>
    </body>
</html>