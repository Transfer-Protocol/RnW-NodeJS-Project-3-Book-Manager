<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Book Store</title>
        <style>
            body{
                font-family: Arial, Helvetica, sans-serif;
            }

            .btn {
                padding: 5px 10px;
                display: inline-block;
                margin: 2px;
                text-decoration: none;
                border-radius: 5px;
            }

            .delete{
                background-color: crimson;
                color: white;
            }

            .edit{
                background-color: rgb(239, 225, 67);
                color: black;
            }

            .primary{
                background-color: cadetblue;
                color: white;
            }

            .card{
                border: 1px solid gray;
                padding: 10px;
                border-radius: 10px;
                width: 20%;
            }

            .card-img{
                border: 1px dotted gray;
            }
            .card-img img{
                object-fit:fill;
                width: 100%;
                height: 350px;
            }

            .card-body{
                margin-top: 10px;
            }

            .dark{
                background-color: black;
                color: white;
            }
        </style>
    </head>
    <body>
        <header>
            <section>
                <p style="color: gray; text-align: center;">This page is not responsive to small devices.</p>
            </section>
            <section>
                <h1 style="text-align: center;">Books Store</h1>
            </section>
            <section>
                <a href="/addbook" class="btn primary">Add Book</a>
                <a href="/viewbooks" class="btn primary">View Books</a>
            </section>
        </header>

        <main>
            <section>
                <p>There are <%=datas.length%> different books.</p>
                <p>There are total <%= datas.reduce((a, b) => {return a + b.quantity}, 0) %> books combined.</p>
            </section>
            <section>
                <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 30px;">
                    <% datas.map((v) => { %>
                        <div class="card">
                            <div class="card-header">
                                <div class="card-img">
                                    <img src="/uploads/<%=v.image%>" alt="">
                                </div>
                            </div>
                            <div class="card-body">
                                <h2 style="text-align: center; margin: 0;"><%= v.bookname %></h2>
                                <p style="margin: 0; font-size: small;"><span style="font-weight: bold;">Authored by</span> <ins><%=v.author%></ins></p>
                                <sub><span style="font-weight: bold;">Price: </span>Rs.<%= v.price %></sub>
                            </div>
                            <div class="card-footer">
                                <a class="btn dark" style="display:block; text-align: center;" href="/bookdetail/<%=v._id%>">Learn More</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </main>
    </body>
</html>